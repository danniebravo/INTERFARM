# InterFarm (Django) — copia este archivo a .env y completa los valores.

APP_KEY=django-insecure-genera-uno-nuevo
APP_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Base de datos MySQL (el MISMO esquema del sistema Laravel)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=somosint_ganado_db
DB_USERNAME=root
DB_PASSWORD=

# Google Maps (mapa de lotes) — clave de navegador restringida por referer.
# También puede vivir en platform_settings (google_maps_api_key).
GOOGLE_MAPS_API_KEY=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@somosinterfarm.com

# IDs de administradores ocultos (separados por coma)
HIDDEN_ADMIN_USER_IDS=1
